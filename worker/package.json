{
  "name": "supplyhq-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute supplyhq --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute supplyhq --local --file=./seed.sql",
    "db:schema": "wrangler d1 execute supplyhq --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute supplyhq --remote --file=./seed.sql",
    "db:marketplace": "wrangler d1 execute supplyhq --remote --file=./migrations/001_marketplace.sql",
    "db:marketplace:local": "wrangler d1 execute supplyhq --local --file=./migrations/001_marketplace.sql",
    "db:agents": "wrangler d1 execute supplyhq --remote --file=./migrations/002_agent_usage.sql",
    "db:agents:local": "wrangler d1 execute supplyhq --local --file=./migrations/002_agent_usage.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
