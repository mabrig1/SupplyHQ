name = "supplyhq-api"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

[vars]
ALLOWED_ORIGINS = "https://supplyhq.mabrigkorie.org,https://mabrig1.github.io"
COMMISSION_RATE = "5"
PAYSTACK_CALLBACK_URL = "https://supplyhq.mabrigkorie.org/dashboard.html"

[[d1_databases]]
binding = "DB"
database_name = "supplyhq"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
